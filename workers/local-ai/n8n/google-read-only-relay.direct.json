            }
          },
          "timeout": 60000
        }
      },
      "id": "r7",
      "name": "Google · GSC",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1328,
        -224
      ],
      "credentials": {
        "googleOAuth2Api": {
          "id": "uEWpjwXHGc414olN",
          "name": "CCPun GSC read-only (n8n)"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.url }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleAnalyticsOAuth2",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 60000
        }
      },
      "id": "r8",
      "name": "Google · GA4",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1328,
        -16
      ],
      "credentials": {
        "googleAnalyticsOAuth2": {
          "id": "MpeqYMGahrZQLPPB",
          "name": "Google Analytics account - CCPun"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const state = $('Relay · Build body').last().json;\nconst relay = $('Relay · Admin').last().json;\nconst planned = $('Relay · แตกคำขอ').all();\nconst fetched = $input.all();\nif (fetched.length !== planned.length) throw new Error('RELAY_RESPONSE_COUNT_MISMATCH');\nconst responses = state.responses.concat(fetched.map((item, index) => ({ key: planned[index].json.key, status: Number(item.json.statusCode) || 502, body: item.json.body ?? null })));\nconst window = state.window ?? (relay.startDate && relay.endDate ? { startDate: relay.startDate, endDate: relay.endDate } : null);\nreturn [{ json: { job: state.job, responses, round: state.round + 1, window } }];"
      },
      "id": "r9",
      "name": "Relay · รวมคำตอบ",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1552,
        -128
      ]
    },
    {
      "parameters": {
        "jsCode": "// Return only Admin's verdict; provider rows never leave this sub-workflow.\nreturn [{ json: $('Relay · Admin').last().json }];"
      },
      "id": "r10",
      "name": "Relay · ผลลัพธ์",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        128
      ]
    }
