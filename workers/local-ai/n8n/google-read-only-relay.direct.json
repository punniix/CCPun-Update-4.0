{
  "name": "CCPun — Google read-only relay (sub-workflow, called by Owner Export 06:00)",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "endpoint"
            },
            {
              "name": "source"
            },
            {
              "name": "lookbackDays",
              "type": "number"
            }
          ]
        }
      },
      "id": "r1",
      "name": "Relay · Start",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Round state: job metadata + provider JSON already fetched. Admin owns request planning, validation and storage.\nconst input = $input.first().json;\nconst job = input.job ?? { endpoint: input.endpoint, source: input.source, lookbackDays: input.lookbackDays ?? 7 };\nif (!['marketing', 'daily'].includes(job.endpoint) || !['gsc', 'ga4'].includes(job.source)) throw new Error('RELAY_INVALID_JOB');\nconst responses = Array.isArray(input.responses) ? input.responses : [];\nconst round = Number.isInteger(input.round) ? input.round : 0;\nconst window = input.window ?? null;\nconst body = job.endpoint === 'marketing'\n  ? { operation: 'relay', source: job.source, ...(window ? { startDate: window.startDate, endDate: window.endDate } : { lookbackDays: job.lookbackDays }), responses }\n  : { source: job.source, relayResponses: responses };\nreturn [{ json: { job, responses, round, window, body } }];"
      },
      "id": "r2",
      "name": "Relay · Build body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.CCPUN_ADMIN_BASE_URL || 'https://admin.ccpun.com') + ($json.job.endpoint === 'marketing' ? '/api/internal/marketing/refresh/' : '/api/internal/analytics/daily/') }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 120000
        }
      },
      "id": "r3",
      "name": "Relay · Admin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        448,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "XH8Mfoa7XEeXo7dw",
          "name": "CCPun Production Analytics Service"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "r4-c",
              "leftValue": "={{ $json.state === 'needs-requests' && Array.isArray($json.requests) && $json.requests.length > 0 && $('Relay · Build body').last().json.round < 5 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "r4",
      "name": "Relay · ต้องดึงเพิ่ม?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        672,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const relay = $input.first().json;\nconst state = $('Relay · Build body').last().json;\nreturn relay.requests.map((request) => ({ json: { key: request.key, url: request.url, body: request.body, source: state.job.source } }));"
      },
      "id": "r5",
      "name": "Relay · แตกคำขอ",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        -128
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "r6-c",
              "leftValue": "={{ $json.source === 'gsc' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "r6",
      "name": "Relay · GSC หรือ GA4?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1104,
        -128
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.url }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
