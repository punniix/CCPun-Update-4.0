  "foundationSource": "@import \"tailwindcss\";\n@source \"../../components\";\n@source \"../../features\";\n@import \"./public-compat.css\";\n@import \"./public-motion.css\";\n@import \"../../features/financial-health-check/styles/print.css\";\n\n/*\n====================================\nCCPun global foundation\n\nOwnership:\n- tokens/theme/document defaults live here\n- cross-feature compatibility classes live in components/styles/public-compat.css\n- shared named animations/reduced-motion live in components/styles/public-motion.css\n- feature-only global contracts stay with their feature owner\n- Website 4.3 visual rules belong in its CSS Modules, not in this file\n====================================\n*/\n\n/* \u2500\u2500 1. CSS Custom Properties (raw HSL channels) \u2500\u2500 */\n:root {\n  color-scheme: dark;\n  --background: 0 15% 18%;\n  --foreground: 0 10% 98%;\n  --card: 0 15% 15%;\n  --card-foreground: 0 10% 98%;\n  --popover: 0 15% 15%;\n  --popover-foreground: 0 10% 98%;\n  --primary: 45 60% 70%;\n  --primary-foreground: 0 15% 12%;\n  --secondary: 0 12% 26%;\n  --secondary-foreground: 0 10% 98%;\n  --muted: 0 12% 26%;\n  --muted-foreground: 0 10% 70%;\n  --accent: 45 60% 70%;\n  --accent-foreground: 0 15% 12%;\n  --destructive: 0 60% 60%;\n  --destructive-foreground: 0 10% 98%;\n  --border: 0 12% 32%;\n  --input: 0 12% 26%;\n  --ring: 45 60% 70%;\n  --radius: 1rem;\n}\n\n/* \u2500\u2500 2. Tailwind v4 Theme \u2500\u2500 */\n@theme inline {\n  --color-background:           hsl(var(--background));\n  --color-foreground:           hsl(var(--foreground));\n  --color-card:                 hsl(var(--card));\n  --color-card-foreground:      hsl(var(--card-foreground));\n  --color-popover:              hsl(var(--popover));\n  --color-popover-foreground:   hsl(var(--popover-foreground));\n  --color-primary:              hsl(var(--primary));\n  --color-primary-foreground:   hsl(var(--primary-foreground));\n  --color-secondary:            hsl(var(--secondary));\n  --color-secondary-foreground: hsl(var(--secondary-foreground));\n  --color-muted:                hsl(var(--muted));\n  --color-muted-foreground:     hsl(var(--muted-foreground));\n  --color-accent:               hsl(var(--accent));\n  --color-accent-foreground:    hsl(var(--accent-foreground));\n  --color-destructive:          hsl(var(--destructive));\n  --color-destructive-foreground: hsl(var(--destructive-foreground));\n  --color-border:               hsl(var(--border));\n  --color-input:                hsl(var(--input));\n  --color-ring:                 hsl(var(--ring));\n\n  --color-navy-900: hsl(0 20% 12%);\n  --color-navy-800: hsl(0 15% 18%);\n  --color-navy-700: hsl(0 12% 26%);\n  --color-gold-400: hsl(45 65% 78%);\n  --color-gold-500: hsl(45 60% 70%);\n  --color-gold-600: hsl(45 55% 60%);\n\n  --radius-sm: calc(var(--radius) - 4px);\n  --radius-md: calc(var(--radius) - 2px);\n  --radius-lg: var(--radius);\n\n  --font-sans: 'Kanit', system-ui, sans-serif;\n\n  --shadow-glass:   0 8px 32px rgba(0,0,0,0.3), inset 0 1px 0 rgba(255,255,255,0.1);\n  --shadow-gold:    0 4px 24px rgba(197,160,89,0.4);\n  --shadow-gold-lg: 0 8px 32px rgba(197,160,89,0.5);\n\n  --animate-fade-in:    fade-in 0.6s ease-out forwards;\n  --animate-fade-in-up: fade-in-up 0.8s ease-out forwards;\n  --animate-scale-in:   scale-in 0.5s ease-out forwards;\n  --animate-float:      float 6s ease-in-out infinite;\n  --animate-pulse-glow: pulse-glow 2s ease-in-out infinite;\n  --animate-shimmer:    shimmer 2s linear infinite;\n  --animate-scroll-breath: scroll-breath 2.4s cubic-bezier(0.16, 1, 0.3, 1) infinite;\n}\n\n/* \u2500\u2500 3. Document foundation \u2500\u2500 */\n@layer base {\n  * {\n    border-color: hsl(var(--border));\n  }\n\n  html {\n    scroll-behavior: smooth;\n    scroll-padding-top: 80px;\n    overflow-x: clip;\n  }\n\n  body {\n    background-color: hsl(var(--background));\n    color: hsl(var(--foreground));\n    font-family: 'Kanit', system-ui, sans-serif;\n    font-size: 1rem;\n    font-weight: 300;\n    line-height: 1.6;\n    -webkit-font-smoothing: antialiased;\n    -moz-osx-font-smoothing: grayscale;\n    overflow-x: clip;\n  }\n\n  :focus-visible {\n    outline: 3px solid #e0c985;\n    outline-offset: 3px;\n  }\n}\n\n/* Admin skip link is intentionally global because Web and Admin share the root stylesheet. */\n.admin-skip-link {\n  position: fixed;\n  left: 1rem;\n  top: 1rem;\n  z-index: 100;\n  min-height: 44px;\n  padding: 0.65rem 1rem;\n  border-radius: 0.75rem;\n  background: #e0c985;\n  color: #251818;\n  font-weight: 600;\n  transform: translateY(-200%);\n  transition: transform 150ms ease-out;\n}\n\n.admin-skip-link:focus {\n  transform: translateY(0);\n}\n\n/* Readability baseline retained only for the reachable shared glass-card primitive. */\n.glass-card .text-xs {\n  font-size: 0.8125rem;\n  line-height: 1.55;\n}\n\n.glass-card .text-sm {\n  font-size: 0.9375rem;\n  line-height: 1.6;\n}\n\n@media (min-width: 768px) {\n  .glass-card .text-xs {\n    font-size: 0.875rem;\n  }\n}\n\n/* Global document scrollbar. Feature scroll containers own their own scrollbar rules. */\n::-webkit-scrollbar { width: 8px; }\n::-webkit-scrollbar-track { background: hsl(0,45%,6%); }\n::-webkit-scrollbar-thumb { background: hsl(0,30%,22%); border-radius: 4px; }\n::-webkit-scrollbar-thumb:hover { background: hsl(42,50%,55%); }\n",
